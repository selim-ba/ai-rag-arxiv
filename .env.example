# Copy this file to .env and fill in your key.
# .env is gitignored. Never commit a real key.

OPENAI_API_KEY=sk-replace-me

# Models. gpt-4o-mini for everything cheap (grading, rewriting);
# swap the answer model up later if quality demands it.
PT_LLM_MODEL=gpt-4o-mini
PT_EMBEDDING_MODEL=text-embedding-3-small

# Where ingested papers and indexes live (gitignored).
PT_DATA_DIR=data

# Chunking. You will tune these in Stage 1 and measure them in Stage 2.
PT_CHUNK_SIZE=800
PT_CHUNK_OVERLAP=120

# Be polite to the free arXiv API: seconds between requests.
PT_ARXIV_DELAY_SECONDS=3.0

PT_LOG_LEVEL=INFO
